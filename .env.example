# Copy to .env and fill in for a server deployment (docker compose --profile server up -d).

# The public domain name; its DNS must point at this server. Caddy gets the HTTPS certificate.
DRAFTIC_DOMAIN=draftic.example.com

# The app's port on this machine (bound to 127.0.0.1; on a server, players come in through Caddy).
DRAFTIC_PORT=8010

# Set to off to turn the per-IP request limits off (local testing only).
# DRAFTIC_RATE_LIMITS=on
